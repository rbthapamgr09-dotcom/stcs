rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // System healthcheck and diagnostic collection
    match /_system/{document=**} {
      allow read, write: if true;
    }

    // Credentials collections (managed server-side and by sync)
    match /user_credentials/{uid} {
      allow read, write: if true;
    }

    match /credentials/{uid} {
      allow read, write: if true;
    }

    // Usernames directory for fast O(1) lookup
    match /usernames/{username} {
      allow read, write: if true;
    }

    // Multi-tenant Offices and subcollections (users, fiscal_years, stores, etc.)
    match /offices/{officeId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // System Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // System Settings collection
    match /system_settings/{settingKey} {
      allow read, write: if true;
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read, write: if true;
    }

    // Legacy and sync collections
    match /system_organizations/{document=**} {
      allow read, write: if true;
    }

    match /system_users/{document=**} {
      allow read, write: if true;
    }

    match /system_connections/{document=**} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}


