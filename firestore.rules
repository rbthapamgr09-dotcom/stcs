rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Multi-tenant Offices
    match /offices/{officeId} {
      allow read: if true;
      allow write: if true;

      // Office-scoped subcollections: Fiscal Years (Employees, Salaries, Deductions, Taxes)
      match /fiscal_years/{fiscalYear} {
        allow read, write: if true;
      }

      // Office-scoped subcollections: Audit Logs
      match /audit_logs/{logId} {
        allow read, write: if true;
      }

      // Any other office-scoped nested subcollections
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // System Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // System Settings (Support contact, app configs, payroll configs)
    match /system_settings/{settingKey} {
      allow read, write: if true;
    }

    // Legacy sync collections (maintained for seamless zero-downtime transition)
    match /system_organizations/{document=**} {
      allow read, write: if true;
    }

    match /system_users/{document=**} {
      allow read, write: if true;
    }

    match /system_connections/{document=**} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
