rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /system_organizations/{document=**} {
      allow read, write: if true;
    }
    match /system_users/{document=**} {
      allow read, write: if true;
    }
    match /system_connections/{document=**} {
      allow read, write: if true;
    }
    match /system_payroll_data/{document=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
