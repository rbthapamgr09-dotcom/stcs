rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // System healthcheck and diagnostic collection
    match /_system/{document=**} {
      allow read, write: if true;
    }

    // System connections & synchronization collection (support contact, main config, org stores)
    match /system_connections/{document=**} {
      allow read, write: if true;
    }

    // System organizations collection
    match /system_organizations/{document=**} {
      allow read, write: if true;
    }

    // System users collection
    match /system_users/{document=**} {
      allow read, write: if true;
    }

    // Credentials collection
    match /user_credentials/{uid} {
      allow read, write: if true;
    }

    match /credentials/{credId} {
      allow read, write: if true;
    }

    // Usernames directory for fast O(1) lookup
    match /usernames/{username} {
      allow read, write: if true;
    }

    // Multi-tenant Offices and subcollections (users, fiscal_years, stores, audit_logs, etc.)
    match /offices/{officeId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // System Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // System Settings collection
    match /system_settings/{settingKey=**} {
      allow read, write: if true;
    }

    // Employees collection
    match /employees/{employeeId=**} {
      allow read, write: if true;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}



